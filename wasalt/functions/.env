# Kashier credentials baked into the deployed Cloud Function (firebase-tools
# reads this file at deploy time and ships the values as function env vars).
# These are TEST-mode keys — the merchant account is not live yet (isLive:false).
# When Kashier activates the merchant: swap in the live keys, set KASHIER_MODE=live,
# and update the two URLs below to the final custom domain.
#
# NOTE: committed to git on purpose — test keys, no live money. Keep live keys out
# of git; set them instead with:  firebase functions:secrets:set KASHIER_SECRET_KEY

KASHIER_MODE=test
KASHIER_MERCHANT_ID=MID-51299-380
KASHIER_PAYMENT_API_KEY=fd999ab4-8157-406e-83b4-9420947368d6
KASHIER_SECRET_KEY=a649cb2b1a177f0127c0bebd77ba9a94$dd84c3468d281968701c42151012b21084cf65aec0f65ab0b6a680fa0f83355ef10fd87d63f2469fa5b351ce93941cbf

# Public origin of the marketing site — Kashier redirects the browser back here.
KASHIER_APP_URL=https://tracking-72393.web.app
# Server-to-server payment notifications (only works with a public URL like this).
KASHIER_WEBHOOK_URL=https://tracking-72393.web.app/api/webhook/kashier
